generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ELECTION_ADMIN
  VOTER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  RESULTS_PENDING
  PUBLISHED
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum CandidateRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CandidateRegistrationFileType {
  PROFILE_PHOTO
  SUPPORTING_DOCUMENT
}

// ---------------------------------------------------------
// USER & AUTHENTICATION
// ---------------------------------------------------------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  fullName      String
  role          Role          @default(VOTER)
  accountStatus AccountStatus @default(PENDING)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  voterProfile     VoterProfile?
  auditLogs        AuditLog[]
  createdElections Election[]    @relation("ElectionCreator")

  @@index([role])
  @@index([accountStatus])
}

model VoterProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  voterId        String   @unique
  registrationNo String   @unique
  eligible       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  participations     BallotParticipation[]
  eligibilityRecords VoterEligibility[]

  @@index([voterId])
  @@index([registrationNo])
}

// ---------------------------------------------------------
// ELECTIONS & POSITIONS
// ---------------------------------------------------------

model Election {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  status      ElectionStatus @default(DRAFT)
  startAt     DateTime
  endAt       DateTime
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy      User                 @relation("ElectionCreator", fields: [createdById], references: [id])
  positions      ElectionPosition[]
  candidates     ElectionCandidate[]
  eligibility    VoterEligibility[]
  participations BallotParticipation[]
  ballots        AnonymousBallot[]
  results        ElectionResult[]
  auditLogs      AuditLog[]

  @@index([status])
  @@index([startAt, endAt])
}

model ElectionPosition {
  id            String   @id @default(cuid())
  electionId    String
  title         String
  description   String   @db.Text
  order         Int      @default(0)
  mandatory     Boolean  @default(true)
  maxSelections Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  election   Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates ElectionCandidate[]
  selections BallotSelection[]
  results    ElectionResult[]

  @@unique([electionId, title])
  @@index([electionId])
}

// ---------------------------------------------------------
// CANDIDATES
// ---------------------------------------------------------

model Candidate {
  id             String          @id @default(cuid())
  fullName       String
  photoUrl       String?
  registrationNo String          @unique
  course         String?
  academicYear   String?
  biography      String          @db.Text
  manifesto      String          @db.Text
  slogan         String?
  education      String?         @db.Text
  status         CandidateStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assignments ElectionCandidate[]
  selections  BallotSelection[]
  results     ElectionResult[]
  registrations CandidateRegistration[]

  @@index([status])
}

model CandidateRegistration {
  id               String                       @id @default(cuid())
  reference        String                       @unique
  cycleKey         String
  fullName         String
  registrationNo   String
  email            String
  phone            String
  faculty          String
  department       String
  course           String
  yearOfStudy      String
  intendedPosition String
  biography        String                       @db.Text
  manifesto        String                       @db.Text
  status           CandidateRegistrationStatus  @default(PENDING)
  candidateId      String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  candidate Candidate?                @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  files     CandidateRegistrationFile[]

  @@unique([registrationNo, cycleKey])
  @@index([status, createdAt])
  @@index([fullName])
  @@index([email])
  @@index([candidateId])
}

model CandidateRegistrationFile {
  id             String                       @id @default(cuid())
  registrationId String
  type           CandidateRegistrationFileType
  originalName   String
  storedName     String                       @unique
  mimeType       String
  size           Int
  createdAt      DateTime                     @default(now())

  registration CandidateRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, type])
}

model ElectionCandidate {
  id          String   @id @default(cuid())
  electionId  String
  positionId  String
  candidateId String
  createdAt   DateTime @default(now())

  election  Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position  ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate Candidate        @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  selections BallotSelection[]

  @@unique([electionId, positionId, candidateId])
  @@unique([positionId, candidateId])
  @@index([electionId])
  @@index([positionId])
}

// ---------------------------------------------------------
// VOTER ELIGIBILITY & PARTICIPATION
// ---------------------------------------------------------

model VoterEligibility {
  id             String   @id @default(cuid())
  electionId     String
  voterProfileId String
  createdAt      DateTime @default(now())

  election     Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voterProfile VoterProfile @relation(fields: [voterProfileId], references: [id], onDelete: Cascade)

  @@unique([electionId, voterProfileId])
  @@index([electionId])
}

model BallotParticipation {
  id              String   @id @default(cuid())
  electionId      String
  voterProfileId  String
  ballotReference String   @unique
  submittedAt     DateTime @default(now())

  election     Election     @relation(fields: [electionId], references: [id], onDelete: Restrict)
  voterProfile VoterProfile @relation(fields: [voterProfileId], references: [id], onDelete: Restrict)

  @@unique([electionId, voterProfileId])
  @@index([electionId])
}

// ---------------------------------------------------------
// BALLOTS & RESULTS (Secrecy Design)
// ---------------------------------------------------------

model AnonymousBallot {
  id              String   @id @default(cuid())
  electionId      String
  ballotReference String   @unique
  submittedAt     DateTime @default(now())

  election   Election         @relation(fields: [electionId], references: [id], onDelete: Restrict)
  selections BallotSelection[]

  @@index([electionId])
}

model BallotSelection {
  id          String @id @default(cuid())
  ballotId    String
  positionId  String
  candidateId String

  ballot   AnonymousBallot  @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  position ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  candidate Candidate       @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  electionCandidate ElectionCandidate? @relation(fields: [positionId, candidateId], references: [positionId, candidateId], map: "fk_selection_valid_candidate")

  @@unique([ballotId, positionId])
  @@index([ballotId])
  @@index([positionId, candidateId])
}

model ElectionResult {
  id          String    @id @default(cuid())
  electionId  String
  positionId  String
  candidateId String
  voteCount   Int       @default(0)
  verified    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  election  Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position  ElectionPosition  @relation(fields: [positionId], references: [id])
  candidate Candidate         @relation(fields: [candidateId], references: [id])

  @@unique([electionId, positionId, candidateId])
  @@index([electionId])
}

// ---------------------------------------------------------
// SYSTEM MANAGEMENT
// ---------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  metadata   String?  @db.Text
  ipAddress  String?
  userAgent  String?
  electionId String?
  createdAt  DateTime @default(now())

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  election Election? @relation(fields: [electionId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}